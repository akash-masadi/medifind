# ══════════════════════════════════════════════════════════════════════
# MediFind — Environment Variables (Backend)
# ══════════════════════════════════════════════════════════════════════
# Copy to /etc/medifind/medifind.env on the production VM and fill in
# the actual values.  NEVER commit real credentials to version control.
#
# Local development requires NO configuration — all defaults reproduce
# the existing development setup.

# ── Secrets (REQUIRED in production) ────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-jwt-secret

# ── MySQL Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Per-service database names (defaults shown; override per systemd unit):
#   auth-service        → medifind_db
#   user-service        → medifind_db
#   doctor-service      → medifind_db
#   hospital-service    → medifind_db
#   appointment-service → medifind_appointment_db
#   notification-service→ medifind_notification_db

# ── Eureka / Service Discovery ──────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_HOSTNAME=localhost

# ── CORS (API Gateway) ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── JWT Expiration (auth-service, optional) ─────────────────────────
# Default: 86400000 (1 day in milliseconds)
# JWT_EXPIRATION=86400000

# ── File Storage (doctor-service, optional) ─────────────────────────
# Default: ./data/licenses (relative to working directory)
# STORAGE_LICENSE_DIR=/opt/medifind/data/licenses

# ── Email (notification-service, optional) ──────────────────────────
# Email is disabled by default.  Set MAIL_ENABLED=true and configure
# the SMTP details when ready to send real email.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=noreply@medifind.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ── SMS (notification-service, optional) ────────────────────────────
# SMS is disabled by default (mock provider).
SMS_ENABLED=false
SMS_PROVIDER=mock

# ── Admin User (REQUIRED for first deployment) ──────────────────────
# The backend will automatically create or update the default ADMIN
# account on startup using these credentials.
ADMIN_EMAIL=admin@medifind.com
ADMIN_PASSWORD=your_secure_password
ADMIN_NAME=Administrator

# ──────────────────────────────────────────────────────────────────────
# Sypmtom Sidecar Configuration (symptom-sidecar)
# ──────────────────────────────────────────────────────────────────────
SIDECAR_ENVIRONMENT = development
SIDECAR_API_TOKEN = dev-token-change-me
SIDECAR_GROQ_API_KEY = gsk_replace_me
SIDECAR_GROQ_MODEL = llama-3.3-70b-versatile
SIDECAR_GROQ_TIMEOUT_SECONDS = 4.0
SIDECAR_MAX_SYMPTOMS = 12